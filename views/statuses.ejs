<%- include('partials/header', { title: 'Statuses' }) %>
  <div class="page-heading">
    <div><p class="eyebrow">Customize your workflow</p><h1>Statuses</h1></div>
  </div>
  <% if (message) { %><div class="notice success" role="status"><%= message %></div><% } %>
  <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
  <section class="card compact" aria-labelledby="add-status-title">
    <h2 id="add-status-title">Add a status</h2>
    <form class="input-action" action="/statuses" method="post">
      <label class="sr-only" for="new-status">New status</label>
      <input id="new-status" name="result" maxlength="100" placeholder="e.g. interviewing" required>
      <button type="submit">Add status</button>
    </form>
  </section>
  <section aria-labelledby="all-statuses-title">
    <div class="section-heading"><h2 id="all-statuses-title">All statuses</h2><span class="count"><%= statuses.length %></span></div>
    <div class="status-list">
      <% statuses.forEach(status => { %>
        <div class="status-row card">
          <form action="/statuses/<%= status.id %>/rename" method="post" class="rename-form">
            <label class="sr-only" for="status-<%= status.id %>">Status name</label>
            <input id="status-<%= status.id %>" name="result" value="<%= status.result %>" maxlength="100" required>
            <button class="secondary" type="submit">Rename</button>
          </form>
          <div class="usage"><%= status.usage_count %> application<%= status.usage_count === 1 ? '' : 's' %></div>
          <form action="/statuses/<%= status.id %>/delete" method="post">
            <button class="danger" type="submit" <%= status.usage_count > 0 ? 'aria-describedby="used-' + status.id + '"' : '' %>>Delete</button>
            <% if (status.usage_count > 0) { %><span class="sr-only" id="used-<%= status.id %>">This status is currently in use and cannot be deleted.</span><% } %>
          </form>
        </div>
      <% }) %>
    </div>
  </section>
<%- include('partials/footer') %>
